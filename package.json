{
  "name": "pokefan-chess",
  "version": "2.10.0",
  "private": true,
  "description": "PokeFan Chess: Red vs Rocket. An unofficial, free, noncommercial fan chess game.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "assets": "node scripts/fetch-assets.mjs",
    "build": "node scripts/copy-engine.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && npm --prefix worker run typecheck",
    "test": "vitest run",
    "e2e": "playwright test",
    "gates": "node scripts/grep-gates.mjs",
    "gates:ci": "node scripts/grep-gates.mjs G1 G3 G5",
    "prepare": "husky",
    "postinstall": "node scripts/copy-engine.mjs",
    "e2e:live": "LIVE_URL=https://pokefanchess.com/ playwright test shell.spec.ts -g @live",
    "gates:dist": "node scripts/grep-gates.mjs",
    "deploy:relay": "npm --prefix worker run deploy",
    "sheets": "SHEETS=1 playwright test --project spritesheet --project fxsheet --project hubsheet --project i18nsheet --project legibilitysheet",
    "kanto:check": "node scripts/build-kanto.mjs --check",
    "trim": "node scripts/trim-sprites.mjs",
    "feedback:pull": "node scripts/feedback-pull.mjs"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "stockfish": "19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "eslint": "10.12.0",
    "fzstd": "0.1.1",
    "husky": "9.1.7",
    "omggif": "1.0.10",
    "pngjs": "7.0.0",
    "sharp": "^0.34.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}

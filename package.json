{
  "name": "pokefan-chess",
  "version": "0.3.0",
  "private": true,
  "description": "PokeFan Chess: Red vs Rocket. An unofficial, free, noncommercial fan chess game.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "assets": "node scripts/fetch-assets.mjs",
    "build": "node scripts/copy-engine.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "gates": "node scripts/grep-gates.mjs",
    "gates:ci": "node scripts/grep-gates.mjs G1 G3 G5",
    "prepare": "husky",
    "postinstall": "node scripts/copy-engine.mjs"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "stockfish": "19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "husky": "9.1.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
